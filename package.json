{
  "name": "matrix-fellows",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev --host 0.0.0.0",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck && tsc --noEmit -p workers/tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "deploy": "npm run build && wrangler deploy",
    "deploy:imports": "wrangler deploy --config workers/wrangler.jsonc",
    "seed": "node --env-file-if-exists=.env scripts/seed.mjs",
    "capture": "node scripts/capture.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.0",
    "@tailwindcss/vite": "^4.1.0",
    "fast-xml-parser": "^5.3.0",
    "gsap": "^3.13.0",
    "lenis": "^1.3.26",
    "nuxt": "^4.1.0",
    "tailwindcss": "^4.1.0",
    "three": "^0.180.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.0.0",
    "@types/three": "^0.180.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "vue-tsc": "^3.0.0",
    "wrangler": "^4.40.0"
  }
}
